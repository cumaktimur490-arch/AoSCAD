#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @AOSCAD_VERSION_COMMA@,0
 PRODUCTVERSION @AOSCAD_VERSION_COMMA@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "AoSCAD Contributors\0"
            VALUE "FileDescription", "AoSCAD Studio\0"
            VALUE "FileVersion", "@PROJECT_VERSION@.0\0"
            VALUE "InternalName", "aoscad-studio\0"
            VALUE "OriginalFilename", "aoscad-studio.exe\0"
            VALUE "ProductName", "AoSCAD Studio\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
